# Copy to .env.local and fill in. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address (business enquiries, privacy requests)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Search & lookup providers ---
SERPAPI_KEY=
BRAVE_SEARCH_API_KEY=
ABSTRACT_PHONE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify service used to text dispute OTP codes (Console > Verify > Services)
TWILIO_VERIFY_SERVICE_SID=
# Optional second reverse-image source
TINEYE_API_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional: Paystack plan code for Pro (NGN 5,000 monthly). With it, Pro renews
# automatically; without it, Pro is a one-off 1-month pass.
PAYSTACK_PRO_PLAN_CODE=

# --- Hashing ---
# Random secret (e.g. `openssl rand -hex 32`) used to HMAC IPs, fingerprints
# and queries before they are written to logs / rate-limit tables.
LOOKX_HASH_SECRET=

# --- Scheduled jobs ---
# Random secret; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/cleanup-images (deletes uploaded images after 24 hours).
CRON_SECRET=
