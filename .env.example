# Copy to .env.local and fill in. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Search & lookup providers ---
SERPAPI_KEY=
BRAVE_SEARCH_API_KEY=
ABSTRACT_PHONE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional second reverse-image source
TINEYE_API_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Hashing ---
# Random secret (e.g. `openssl rand -hex 32`) used to HMAC IPs, fingerprints
# and queries before they are written to logs / rate-limit tables.
LOOKX_HASH_SECRET=
